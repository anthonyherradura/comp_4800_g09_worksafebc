{
  "name": "hiips360",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite",
    "dev:api": "node --watch --env-file=.env server/index.js",
    "dev:all": "concurrently -n api,web -c blue,yellow \"npm:dev:api\" \"npm:dev\"",
    "dev:phone": "concurrently -n api,web -c blue,yellow \"npm:dev:api\" \"npm:dev -- --host\"",
    "api": "node --env-file=.env server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test --experimental-test-module-mocks \"tests/*.test.js\"",
    "test:ai-live": "node --env-file=.env scripts/ai-smoke.mjs",
    "db:setup": "node --env-file=.env scripts/db-setup.mjs",
    "test:db": "node --env-file-if-exists=.env --test \"tests/db/*.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@huggingface/transformers": "^4.3.1",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "idb-keyval": "^6.3.0",
    "minisearch": "^7.2.0",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
