# Copy to .env (git-ignored) and fill in. Read by `npm run api` / `npm run dev:api`.

# Local MongoDB service. Use 127.0.0.1, not localhost: Node tries IPv6 (::1) first and
# the Windows mongod only listens on IPv4. An Atlas URI can replace this later.
MONGODB_URI=mongodb://127.0.0.1:27017/hiips360
# Transactions need MongoDB running as a replica set; npm run db:setup explains the one-time change if it isn't.
# For npm run test:db (creates and drops its own hiips360_test_* database):
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the API listens on. vite.config.js proxies /api here.
PORT=3001

# Gemini API key for hazard suggestions (each developer uses their own)
GEMINI_API_KEY=
# Fastest and most accurate in our Nov 2026 benchmark (about 0.6 s, 24/24 correct). Gemma is Google's open model.
GEMINI_MODEL=gemma-4-26b-a4b-it
# Raced in if GEMINI_MODEL fails or is slow (>2.5 s). Leave empty to turn the fallback off.
# Every model must accept "minimal" thinking. These three do; 3.6 Flash also does but takes 3-5 s,
# and 3.7+ / 3.8 Flash had no usable free quota.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Third model, started if the other two fail or are slow (another 2.5 s). Leave empty to turn it off.
GEMINI_SECOND_FALLBACK_MODEL=gemini-3.5-flash-lite