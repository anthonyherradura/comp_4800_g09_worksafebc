-        if (deletedCount === 0) throw notFound("selected sheet");
-        await bumpRevision([inspectionId], session);
-    });
-}
-
-export function setChecklistStatus({ inspectionId, checklistItemId, status }) {
-    return inTransaction(async (session) => {
